{
  "expo": {
    "name": "ANet",
    "slug": "agent-network-app",
    "version": "0.2.254",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon-ios.png",
      "supportsTablet": true,
      "bundleIdentifier": "top.vansin.agentnetwork",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "允许把图片保存到相册",
        "LSApplicationQueriesSchemes": [
          "itms-beta"
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以发送图片给 agent",
          "cameraPermission": "允许使用相机拍照发送给 agent"
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6f7f9",
          "dark": {
            "image": "./assets/android-icon-foreground.png",
            "backgroundColor": "#111113"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "按住说话时录音,转成文字填进输入框(语音输入)",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/with-no-aps-environment",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1b65db"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#011133",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.agentnetworkapp",
      "versionCode": 2254,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ]
    }
  }
}
