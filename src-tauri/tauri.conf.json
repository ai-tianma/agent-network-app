{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANet",
  "version": "0.2.283",
  "identifier": "top.vansin.agentnetwork.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ANet",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundColor": "#111113"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/commhub"
    ],
    "resources": [
      "binaries/commhub-manifest.json"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "template": "./windows/vendor/installer.tauri-2.11.2.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/brand/header.bmp",
        "uninstallerHeaderImage": "windows/brand/header.bmp",
        "sidebarImage": "windows/brand/sidebar.bmp"
      },
      "wix": {
        "template": "./windows/vendor/main.tauri-2.11.2.wxs",
        "upgradeCode": "4777ee3d-8db8-576a-a7ad-361f79904d32"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QkMwODAxQkMzQTJBQjkKUldTNUtqcThBUWk4TlNtZjB4L2hOLzRHQjdjNVlNOWMvSjVteGR5aVV5d2FJSENxRWIwUllxMEIK",
      "endpoints": [
        "https://anet.sh/desktop/update/latest.json",
        "https://modelscope.cn/datasets/SmartFlowAI/agent-network-releases/resolve/master/desktop/latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
