# Real historical npm packages, not edited manifest versions or CLI stubs.
ARG NATIVE_IMAGE
FROM node:22-bookworm@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS legacy
USER node
RUN npm install -g --prefix /home/node/old-cli --no-audit --no-fund \
      @sleep2agi/agent-network@2.3.0-preview.76 @sleep2agi/agent-node@2.5.0-preview.128 && \
    npm install -g --prefix /home/node/old-node --no-audit --no-fund \
      @sleep2agi/agent-network@2.3.0-preview.162 @sleep2agi/agent-node@2.5.0-preview.58
RUN /home/node/old-cli/bin/anet --version && \
    /home/node/old-node/bin/anet --version && \
    node /home/node/old-node/lib/node_modules/@sleep2agi/agent-node/dist/cli.js --help
FROM ${NATIVE_IMAGE}
USER root
COPY --from=legacy --chown=10001:10001 /home/node/old-cli/ /fixture/old-cli-prefix/
COPY --from=legacy --chown=10001:10001 /home/node/old-node/ /fixture/old-node-prefix/
COPY tests/linux-native-daemon/run.sh /fixture/native-daemon.sh
COPY tests/linux-native-daemon/verify.mjs /fixture/daemon-verify.mjs
RUN bash -n /fixture/native-daemon.sh && node --check /fixture/daemon-verify.mjs
USER smoke
CMD ["sh", "/fixture/keyring.sh", "bash", "/fixture/native-daemon.sh", "old-cli"]
