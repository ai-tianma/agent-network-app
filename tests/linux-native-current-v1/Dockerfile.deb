# Import exact, already-built TEST-ONLY bytes; no compilation or public release.
FROM node:22-bookworm@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
ARG SOURCE_COMMIT
ARG DEB_SHA256
ENV TEST_DEB_SOURCE_COMMIT=$SOURCE_COMMIT TEST_DEB_SHA256=$DEB_SHA256
COPY ANet_0.2.249_amd64.deb /app/src-tauri/target/release/bundle/deb/ANet_0.2.249_amd64.deb
COPY TEST-ONLY.txt /fixture/TEST-ONLY.txt
RUN test "${#SOURCE_COMMIT}" = 40 && test "${#DEB_SHA256}" = 64 && \
    grep -Fx "App source: $SOURCE_COMMIT" /fixture/TEST-ONLY.txt && \
    printf '%s  /app/src-tauri/target/release/bundle/deb/ANet_0.2.249_amd64.deb\n' "$DEB_SHA256" | sha256sum -c -
